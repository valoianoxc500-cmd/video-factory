GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_STT_LOCATION=us-central1
SERPER_API_KEY=your-serper-api-key
PEXELS_API_KEY=your-pexels-api-key

# Additional media libraries. Each is optional: a provider without its key
# reports that it needs one and is skipped, rather than failing the run.
# Wikimedia Commons needs no key at all.
PIXABAY_API_KEY=your-pixabay-api-key
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
# Unsplash requires attribution links to carry your app's utm source.
UNSPLASH_APP_NAME=video_factory

# Research providers. Both return reference material only -- neither offers a
# file this pipeline may republish.
YOUTUBE_API_KEY=your-youtube-data-api-v3-key
NEWSAPI_KEY=your-newsapi-key

# Optional overrides
GEMINI_PRIMARY_MODEL=gemini-2.5-pro
GEMINI_REVIEW_MODEL=gemini-3-flash-preview
GEMINI_TTS_MODEL=gemini-2.5-pro-tts
REMOTION_REQUIRE_GPU=false
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

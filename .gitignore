config/channels/assets/senior_health_watermark.png
assets/channels/senior_health/
*.mp4
*.mp3
*.raw

# AI Video Maker voice samples are product assets shipped with the app, not
# generated media: the voice picker plays the real Edge TTS voice so the
# preview matches what the finished video will sound like.
!web/public/voice-previews/*.mp3
.claude/
.codex/
.vscode/
.pytest_cache/
.fixtures/


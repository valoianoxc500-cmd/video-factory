# Worker configuration. Copy to worker/.env and fill in.
# worker/.env is gitignored - never commit real values.

# The deployed Vercel app the worker polls for jobs.
APP_URL=https://your-app.vercel.app

# Shared secret. Must match the WORKER_TOKEN environment variable
# set on the Vercel project.
WORKER_TOKEN=

# Media storage backend. See worker/storage.py for the provider contract.
#
#   gcs       Google Cloud Storage (default). Resumable uploads, no per-object
#             size ceiling, authenticated with the Application Default
#             Credentials the pipeline already uses for Vertex AI and STT --
#             so there is no extra secret here. The bucket must be readable by
#             allUsers for <video src> playback.
#   supabase  Previous backend, kept for rollback only. Its free tier rejects
#             any object over 50 MB on BOTH the standard and the resumable
#             endpoint, and finished videos run 97-121 MB.
MEDIA_STORAGE_PROVIDER=gcs
GCS_BUCKET=<your-bucket>

# Supabase project holding the job queue (Postgres). Still required for job
# state; only the media path moved to GCS.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=<publishable/anon key>
SUPABASE_BUCKET=media

# Channel to generate for.
VIDEO_CHANNEL=football_news

# Seconds between queue polls when idle.
POLL_INTERVAL_SECONDS=15

# Advisory review gates: they still run and record a verdict, but a
# rejection does not discard an already-rendered video.
ALLOWED_REVIEW_FAILURES=image_review,thumbnail_review,final_review

# Videos kept in object storage. On GCS this is a cost control, not a quota:
# ~110 MB each at roughly $0.02/GB/month.
VIDEO_RETENTION=12
